# zstfsd configuration file

# HTTP listen settings
listen_addr = "0.0.0.0"
listen_port = 8080

# zStFS data root directory (required)
root_path = "/var/lib/zstfs"

# Cache size limits in megabytes (optional)
#compressed_cache_mb = 128
#decoded_cache_mb = 32

markets:	# Market definitions
{
	cna:	# market name
	{
		# CNA  - China A-share market (4 daily hours, Mon-Fri)
		schedule = "CNA"

		#fields = "ohlcv"	# ohlcv/cv  default: ohlcv
	}
}
